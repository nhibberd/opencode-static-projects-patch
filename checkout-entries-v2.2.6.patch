+++ b/packages/app/src/runtime/server/checkouts.ts
@@ -0,0 +1,54 @@
+import { containsDirectory } from "@opencode/util/path"
+import { pathKey } from "@/workspaces/path-key"
+import type { Project } from "./types"
+
+export type Checkout = {
+  projectID: string
+  directory: string
+  name?: string
+  icon?: Pick<NonNullable<Project["icon"]>, "color" | "override">
+}
+
+export function checkoutProjects(projects: readonly Project[], checkouts: readonly Checkout[]): Project[] {
+  return checkouts
+    .flatMap((checkout) => {
+      const key = pathKey(checkout.directory)
+
+      const project =
+        projects.find((item) => pathKey(item.worktree) === key || item.sandboxes.includes(checkout.directory)) ??
+        projects.find((item) => item.id === checkout.projectID)
+
+      if (!project) return []
+
+      const canonical = pathKey(project.worktree) === key
+
+      const sandboxes = canonical
+        ? project.sandboxes.filter(
+            (directory) => !checkouts.some((item) => pathKey(item.directory) === pathKey(directory)),
+          )
+        : []
+
+      return [
+        {
+          ...project,
+          worktree: checkout.directory,
+          name: checkout.name ?? (canonical ? project.name : undefined),
+          icon: checkout.icon ? { ...project.icon, ...checkout.icon } : project.icon,
+          sandboxes,
+          worktrees: project.worktrees.filter(
+            (item) => pathKey(item.directory) === key || sandboxes.includes(item.directory),
+          ),
+        },
+      ]
+    })
+    .toSorted((a, b) => b.time.active - a.time.active)
+}
+
+export function checkoutForDirectory(projects: readonly Project[], directory: string) {
+  return (
+    projects
+      .filter((project) => containsDirectory(project.worktree, directory))
+      .toSorted((a, b) => b.worktree.length - a.worktree.length)[0] ??
+    projects.find((project) => project.sandboxes.some((sandbox) => containsDirectory(sandbox, directory)))
+  )
+}
