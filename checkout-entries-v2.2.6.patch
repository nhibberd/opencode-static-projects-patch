+test("checkout entries with the same project ID keep independent names, last selection, and visibility across reloads", () => {
+  const decode = Schema.decodeUnknownSync(serverSchema())
+  const [store, setStore] = createStore(decode({}))
+  const projects = createServerProjects({ store, setStore, scope: () => ServerScope.local })
+  projects.migrateCheckouts([{ projectID: "repo", directory: "/primary" }])
+  projects.touch("repo", "/slot-1")
+  projects.touch("repo", "/slot-2")
+  projects.rename("/slot-1", "API work")
+  projects.touch("repo", "/slot-1/")
+  expect(projects.checkouts()).toEqual([
+    { projectID: "repo", directory: "/primary" },
+    { projectID: "repo", directory: "/slot-1", name: "API work" },
+    { projectID: "repo", directory: "/slot-2" },
+  ])
+  expect(projects.lastCheckout()).toBe("/slot-1/")
+  projects.migrateCheckouts([{ projectID: "repo", directory: "/should-not-replace" }])
+  const [restored, save] = createStore(decode(Schema.encodeSync(serverSchema())(store)))
+  const reopened = createServerProjects({ store: restored, setStore: save, scope: () => ServerScope.local })
+  reopened.hideCheckout("/slot-1")
+  expect(reopened.checkouts()?.map((entry) => entry.directory)).toEqual(["/primary", "/slot-2"])
+  expect(reopened.lastCheckout()).toBe("/slot-2")
+  expect(reopened.used()).toEqual(["repo"])
+  reopened.hideCheckout("/primary")
+  reopened.hideCheckout("/slot-2")
+  expect(reopened.checkouts()).toEqual([])
+  expect(reopened.used()).toEqual([])
+})
